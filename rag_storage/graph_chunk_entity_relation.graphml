</node>
<node id="Pioglitazone">
  <data key="d0">Pioglitazone</data>
  <data key="d1">drug</data>
  <data key="d2">Pioglitazone is another thiazolidinedione that improves insulin sensitivity in muscle and adipose cells.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838947</data>
  <data key="d6"></data>
</node>
<node id="Pramlintide">
  <data key="d0">Pramlintide</data>
  <data key="d1">drug</data>
  <data key="d2">Pramlintide is an injectable hormone that regulates blood glucose by slowing food absorption and inhibiting glucagon.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838948</data>
  <data key="d6"></data>
</node>
<node id="Exenatide">
  <data key="d0">Exenatide</data>
  <data key="d1">drug</data>
  <data key="d2">Exenatide is an injectable antihyperglycemic drug that mimics incretin hormones to stimulate insulin release.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838948</data>
  <data key="d6"></data>
</node>
<node id="Sitagliptin">
  <data key="d0">Sitagliptin</data>
  <data key="d1">drug</data>
  <data key="d2">Sitagliptin is a drug that inhibits DPP-4, increasing levels of incretins to enhance glucose control.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838948</data>
  <data key="d6"></data>
</node>
<node id="Semaglutide">
  <data key="d0">Semaglutide</data>
  <data key="d1">drug</data>
