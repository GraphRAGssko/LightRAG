  <data key="d0">Glimepiride</data>
  <data key="d1">drug</data>
  <data key="d2">Glimepiride is another sulfonylurea that helps control blood glucose levels by increasing insulin secretion.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838947</data>
  <data key="d6"></data>
</node>
<node id="Metformin">
  <data key="d0">Metformin</data>
  <data key="d1">drug</data>
  <data key="d2">Metformin is the primary biguanide that decreases liver glucose production and enhances insulin action on tissues.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838947</data>
  <data key="d6"></data>
</node>
<node id="Rosiglitazone">
  <data key="d0">Rosiglitazone</data>
  <data key="d1">drug</data>
  <data key="d2">Rosiglitazone is a thiazolidinedione that helps control blood sugar by reducing insulin resistance.</data>
  <data key="d3">chunk-13061af8ceaf1fb5f240b0dc1225d36f</data>
  <data key="d4">diabetes_insulin_therapies.txt</data>
  <data key="d5">1774838947</data>
