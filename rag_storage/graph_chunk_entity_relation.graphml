</node>
<node id="Wakefield">
  <data key="d0">Wakefield</data>
  <data key="d1">location</data>
  <data key="d2">Wakefield is a location in England where Richard, Duke of York was killed by Lancastrian forces during the Wars of the Roses.</data>
  <data key="d3">chunk-dfa85355242315f033b4bb60edaa01d2</data>
  <data key="d4">wars_of_the_roses.txt</data>
